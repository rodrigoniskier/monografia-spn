APP_ENV=development
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,monografiaspn.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://monografiaspn.pythonanywhere.com
DJANGO_HSTS_PRELOAD=true

# Nunca exponha esta chave no navegador ou no repositório.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Identifica a aplicação nos serviços acadêmicos públicos.
RESEARCH_CONTACT_EMAIL=niskier.rodrigo@gmail.com

# CitaRN: importação, enriquecimento bibliográfico e arquivos protegidos.
CROSSREF_ENRICH=true
CROSSREF_MAILTO=niskier.rodrigo@gmail.com
MAX_UPLOAD_FILE_SIZE=20971520
MAX_FILES_PER_IMPORT=10
URL_FETCH_MAX_BYTES=3145728
MEDIA_ROOT=/home/monografiaspn/monografia-spn/media

# Produção no PythonAnywhere
PAW_USERNAME=monografiaspn
